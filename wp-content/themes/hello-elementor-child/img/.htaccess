# Keep the owner-supplied cork texture unchanged through image-optimizing proxies.
<IfModule mod_headers.c>
    <Files "corkboard-1920.jpg">
        Header set Cache-Control "public, max-age=604800, no-transform"
    </Files>
    <Files "corkboard-repeat.svg">
        Header set Cache-Control "public, max-age=604800, no-transform"
    </Files>
</IfModule>
