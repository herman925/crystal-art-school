# Editor / design-tool metadata
*.artifact.json

# OS / scratch
.DS_Store
Thumbs.db
*.tmp

# Local source uploads & scratch exports (not part of the site)
/uploads/

# drawio working files
*.drawio
.$*.bkp

.gstack/
__pycache__/

# Client working material — this repo is PRIVATE now (it was public and served GitHub Pages; keep this material out of it anyway).
# Meeting recordings, the client's handwritten feedback boards, and the internal
# design/spec documents must not be published. Keep them local.
/docs/*Design Discussion Minutes*
/docs/*_Design_Direction*
/docs/*_SPEC_*
/docs/*_Coverage_Audit*
/docs/*_Letter_Spacing_*
/docs/*_Blog_Devnotes_*
/docs/*_About_Copy_Provenance*
/docs/*_Session_Handoff*
/docs/*頁面*.jpg
/docs/*解說*.jpg
/.scratch/
.verify-report.json

# impeccable hook cache — machine-written, not shared
.impeccable/hook.cache.json

# Scope and commercial reasoning, and the cut-outs the client did not supply.
# The repo is public with Issues enabled — neither belongs in it.
/docs/*_Transparency_Work_*

# Drafts of messages TO the client, and replies filed against her review threads.
# Same rule as the thread bodies themselves: this repo is public and search-indexed,
# so outgoing correspondence does not live in it either. These drafts belong beside
# the meeting minutes at "Crystal Education Project/docs/client-messages/", which is
# outside any git repository. (2026-08-21 — a draft was committed here and pushed
# before this line existed; see the commit that added it.)
/docs/client-messages/
/docs/asset-cutouts/

# Credentials. The client's platform logins live OUTSIDE this repo, at
# "Crystal Education Project/.secrets/.env" — this repo is public and serves
# GitHub Pages. These patterns exist so that a stray .env created in here is
# never committed by accident; they are a backstop, not the storage location.
.env
.env.*
!.env.example
/.secrets/

# Guide build output and dependencies (B, 2026-10)
docs-site/node_modules/
docs-site/site/.vitepress/dist/
docs-site/site/.vitepress/cache/
# Login backstop: bcrypt hashes, never committed
docs-site/server/users.php
docs-site/.htpasswd
